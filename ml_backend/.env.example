# ML Backend Environment Template
# Copy to .env and adjust values for your deployment.

# Runtime
DEVICE=cpu
HOST=0.0.0.0
PORT=8000
PROJECT_NAME=DefectDetect Web API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Model paths
SAM_CHECKPOINT=models/sam_vit_h_4b8939.pth
YOLO_MODEL=models/yolo26n.pt

# Output
SYNTHETIC_OUTPUT_DIR=output/synthetic
PATCH_OUTPUT_DIR=output/patches

# Security
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/defectdetect
DATABASE_SYNC_URL=postgresql+psycopg://postgres:password@localhost:5432/defectdetect
DB_ECHO=false

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=output/uploads
MAX_UPLOAD_SIZE_MB=100
S3_BUCKET_NAME=
S3_REGION=
